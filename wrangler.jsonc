// The demo Worker. No resource ids here (a public repository). Secrets: see
// README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pointsman-demo-buildings",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "buildings.demo.pointsman.net", "custom_domain": true }],
  // Only the custom domain: the Cache API does nothing on workers.dev, so
  // every request there would reach the broker.
  "workers_dev": false,
  "vars": {
    "BROKER_URL": "https://geolonia-demo.geonicdb.jp",
    "BROKER_TENANT": "pointsman_buildings",
    // Pointsman runs on workers.dev in the same account (see compatibility_flags).
    "POINTSMAN_URL": "https://pointsman.geolonia.workers.dev",
    // Requests a day for the whole demo, besides 5 a minute per visitor.
    "DAILY_LIMIT": "300",
    // Scene B (descriptions read by AI): "on" once the queue exists, the token
    // may use building-concern, and the profile is published.
    "CONCERNS": "off",
    // Photos in scene B: "on" once the profile reads images (engine image support, pointsman#289).
    "PHOTOS": "off"
  },
  // The page (site/). The Worker answers the API and the bridge (/notify);
  // everything else is a static file.
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/notify"]
  },
  // Requests per visitor (IP) and minute.
  "ratelimits": [
    // Per visitor, and for all visitors together (one key). Cloudflare counts
    // per location and only roughly, so both keep bursts small, nothing more.
    { "name": "REQUEST_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "ALL_REQUESTS_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  // Scene B's photos (src/photos.ts). The bucket must exist, with a lifecycle
  // rule that deletes objects after 1 day.
  "r2_buckets": [{ "binding": "PHOTOS_BUCKET", "bucket_name": "pointsman-demo-buildings-photos" }],
  // Hourly: delete requests older than a day, with their Decision and Task entities.
  "triggers": { "crons": ["23 * * * *"] },
  // The bridge's queue: notifications are answered at once and handled here
  // with retries; the chained scene B route runs only from it. The queues must
  // exist before a deploy (wrangler queues create ...).
  "queues": {
    "producers": [
      { "binding": "BRIDGE_QUEUE", "queue": "pointsman-demo-buildings-bridge" },
      { "binding": "BRIDGE_DLQ", "queue": "pointsman-demo-buildings-bridge-dlq" }
    ],
    "consumers": [{ "queue": "pointsman-demo-buildings-bridge", "max_batch_timeout": 1, "max_retries": 20, "max_concurrency": 1, "dead_letter_queue": "pointsman-demo-buildings-bridge-dlq" }]
  }
}
